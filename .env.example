# Claude: reads the poster and picks deep cuts. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Last.fm: play counts for "most popular". Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Apple Music: Apple Developer -> Certificates, IDs & Profiles -> Keys -> new key with MusicKit enabled.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=~/.keys/AuthKey_XXXXXXXXXX.p8
# Optional; detected from your account if blank (e.g. "us")
APPLE_STOREFRONT=
